# Optional, for scripts only: `npm run gen:summaries` regenerates the fixture summaries with Claude.
# The site itself needs no key. Vite inlines VITE_* into the client bundle, so never deploy a build made while this file holds a key.
VITE_ANTHROPIC_API_KEY=
VITE_MODEL=claude-fable-5-1
VITE_EMBED_MODEL=Xenova/all-MiniLM-L6-v2
